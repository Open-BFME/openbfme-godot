* text=auto

# Godot-generated sidecars are always written with LF, but `text=auto` asks for
# CRLF in a Windows working tree, so every editor run or `--import` leaves the
# whole set "modified" with zero content change. That churn is not harmless: it
# buried real edits in `git status`, and agents working in this tree repeatedly
# had to prove a 237-file diff was only line endings before they could trust it.
# Pinning the generated formats to LF makes what Godot writes and what Git
# expects the same thing.
*.import text eol=lf
*.uid    text eol=lf

# Committed census data is regenerated by tools that write LF and must be
# byte-identical across regenerations; `text=auto` would hand a Windows
# checkout CRLF copies that immediately read as stale.
game/data/*.json text eol=lf

# Keep large binary game assets out of regular Git object history.
*.glb filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text

# Contract fixtures are byte-compared by tests; keep them LF everywhere.
contracts/*.json text eol=lf
contracts/fixtures/*.json text eol=lf
importer/tests/fixtures/cook/** text eol=lf

# Godot rewrites project.godot with LF (and its standard header) whenever it saves settings.
godot/project.godot text eol=lf

# Golden tables are compared byte-for-byte by tests and regenerated by tools/ini_macro_oracle.py with LF
# endings; a CRLF checkout must not change them (the reader still tolerates one CR before LF).
engine/tests/data/** text eol=lf

# The vendored Lua 4.0.1 tree is pristine upstream content checked against engine/thirdparty/lua-4.0.1.manifest: no line-ending
# conversion on any platform.
engine/thirdparty/lua-4.0.1/** -text
# The Lua patch layer is diffed against the pristine tree (engine/src/Libraries/Lua/ea-fork.patch): LF everywhere.
engine/src/Libraries/Lua/** text eol=lf
