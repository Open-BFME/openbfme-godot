	var contained:=sim.entities[31] as Dictionary;sim._attach_stealth_detector_contract(contained,_detector());sim.entity_container[31]=999;detector["position"]=Vector2(100,0);hidden["position"]=Vector2.ZERO;hidden.erase("detected_until_tick");sim.tick();_check("contained_detector_gate_blocks",sim._stealth_active(hidden));_check("ring_cancel_receipted",((detector["stealth_detector_update"] as Dictionary).get("unsupported_semantics",[]) as Array).has("unsupported_ring_presentation:CancelOneRingEffect"))
	var unresolved:={};sim._attach_stealth_detector_contract(unresolved,{"module":"StealthDetectorUpdate","extraction":"typed","fields":{"DetectionRate":{"expression":"MISSING"},"DetectionRange":{"value":10}}});_check("unresolved_detector_inert",int((unresolved["stealth_detector_update"] as Dictionary).get("rate_ticks",0))==-1)
	var snap:=sim.snapshot();var hash:=sim.state_hash();var restored:=_sim();_check("snapshot_restore",restored.restore(snap));_check("hash_restore",restored.state_hash()==hash)
	print("UPGRADE_GATE_STEALTH_RUNTIME_RESULT passed=%d failed=%d"%[passed,failed]);quit(0 if failed==0 and passed==EXPECTED else 1)
