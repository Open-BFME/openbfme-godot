func _run()->void:
	var sim:=_sim();var source:=sim.entities[10] as Dictionary;sim._attach_give_upgrade_contract(source,_give())
	var action:=sim.request_give_upgrade(10,50,"Upgrade_Test","SpecialAbilityGiveUpgrade");_check("give_request_accepts",bool(action.get("ok",false)));_check("give_exact_delivery_tick",int(action.get("delivery_tick",0))==3);_check("give_busy_rejected",String(sim.request_give_upgrade(10,50,"Upgrade_Other").get("reason",""))=="upgrade-delivery-busy");sim.advance(2);_check("upgrade_not_early",not (sim.structures[50].get("completed_upgrades",[]) as Array).has("Upgrade_Test"));sim.advance(1);_check("upgrade_delivered",(sim.structures[50].get("completed_upgrades",[]) as Array).has("Upgrade_Test"));sim.advance(1);_check("give_action_packs_and_clears",not source.has("give_upgrade_action"));_check("give_fx_receipted",((source.get("give_upgrade_updates",[]) as Array)[0].get("unsupported_semantics",[]) as Array).has("presentation_binding:SpawnOutFX"));sim.request_give_upgrade(10,50,"Upgrade_Dead");source["health"]=0;sim.advance(3);_check("dead_source_cancels_delivery",not (sim.structures[50].get("completed_upgrades",[]) as Array).has("Upgrade_Dead"));source["health"]=100
