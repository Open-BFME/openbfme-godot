	var gate:=sim.structures[60] as Dictionary;sim._attach_gate_open_close_contract(gate,_gate());sim._attach_fake_pathfind_portal_contract(gate,_portal());_check("enemy_portal_denied",not sim.gate_portal_allows(60,20));_check("friendly_portal_allowed",sim.gate_portal_allows(60,10));var opened:=sim.request_gate_open(60,10);_check("gate_opens",bool(opened.get("ok",false)) and bool((gate["gate_behavior"] as Dictionary).get("pathing_open",false)));sim.advance(2);_check("gate_closes_exact_reset",not bool((gate["gate_behavior"] as Dictionary).get("open",true)));_check("gate_audio_receipted",((gate["gate_behavior"] as Dictionary).get("unsupported_semantics",[]) as Array).has("audio_binding:SoundOpeningGateLoop"))
	var ai_gate:=sim.structures[61] as Dictionary;sim._attach_gate_open_close_contract(ai_gate,_gate());sim._attach_ai_gate_contract(ai_gate,_ai_gate());source["position"]=Vector2(25,0);sim.tick();_check("ai_gate_trigger_opens",bool((ai_gate["gate_behavior"] as Dictionary).get("open",false)));source["position"]=Vector2(50,0);sim.advance(2);_check("ai_gate_closes_after_departure",not bool((ai_gate["gate_behavior"] as Dictionary).get("open",true)))
