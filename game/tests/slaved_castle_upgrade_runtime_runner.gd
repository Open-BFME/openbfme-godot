	var snap:=sim.snapshot();var hash:=sim.state_hash();var restored:=_sim();_check("snapshot_restore",restored.restore(snap));_check("hash_restore",restored.state_hash()==hash)
	print("SLAVED_CASTLE_UPGRADE_RUNTIME_RESULT passed=%d failed=%d"%[passed,failed]);quit(0 if failed==0 and passed==EXPECTED else 1)
func _slave(die:bool)->Dictionary:return {"module":"SlavedUpdate","extraction":"typed","fields":{"LeashRange":{"value":250.0},"GuardMaxRange":{"value":420.0},"GuardWanderRange":{"value":15.0},"AttackRange":{"value":100.0},"UseSlaverAsControlForEvaObjectSightedEvents":{"value":true},"DieOnMastersDeath":{"value":die},"MarkUnselectable":{"value":true},"GuardPositionOffset":{"value":{"x":-15.0,"y":0.0,"z":0.0}},"FadeOutRange":{"value":20.0},"FadeTime":{"milliseconds":1000}}}
func _castle(radius:String)->Dictionary:return {"module":"CastleUpgrade","extraction":"typed","fields":{"TriggeredBy":{"value":"Upgrade_Trigger"},"Upgrade":{"value":"Upgrade_Real"},"WallUpgradeRadius":{"define":radius,"expression":radius}}}
func _sim()->RetailSliceSim:
	var unit_rules:={};for oid in [Sim.SOLDIER_OBJECT_ID,Sim.SOLDIER_HORDE_ID,Sim.ARCHER_OBJECT_ID,Sim.TOWER_GUARD_OBJECT_ID,Sim.KNIGHT_OBJECT_ID]:unit_rules[oid]=_rule()
	var s:RetailSliceSim=Sim.new();s.setup({}, {"unit_rules":unit_rules,"source_unit_scale":0.1,"castle_upgrade_radius_defines":{"WALL_RADIUS":500.0}});s.ai_enabled=false;s.base_loop_enabled=false;s.entities.clear();s.structures.clear();s.entities[10]=_unit(10,0);s.entities[11]=_unit(11,0);s.entities[20]=_unit(20,2);s.structures[50]={"id":50,"team":1,"health":100,"position":Vector2(10,10)};s.structures[51]={"id":51,"team":1,"health":100,"position":Vector2.ZERO};s.structures[60]={"id":60,"team":0,"health":100,"position":Vector2.ZERO,"completed_upgrades":[],"castle_piece_structure_ids":[61,62]};s.structures[61]={"id":61,"team":0,"health":100,"completed_upgrades":[]};s.structures[62]={"id":62,"team":0,"health":100,"completed_upgrades":[]};return s
