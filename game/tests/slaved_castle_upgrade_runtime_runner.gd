extends SceneTree
const Sim=preload("res://src/retail_slice/retail_slice_sim.gd")
const EXPECTED:=36
var passed:=0;var failed:=0
func _initialize()->void:call_deferred("_run")
func _run()->void:
	var sim:=_sim();var slave:=sim.entities[10] as Dictionary;sim.selected_ids=[10];sim._attach_slaved_update_contract(slave,_slave(true))
	_check("slaved_typed_attaches",slave.has("slaved_update"));_check("mark_unselectable_applied",bool(slave.get("unselectable",false)) and not sim.selected_ids.has(10));_check("attack_range_preserved",float((slave["slaved_update"] as Dictionary).get("attack_range_source",0.0))==100.0);_check("attack_range_is_executable",not ((slave["slaved_update"] as Dictionary).get("unsupported_semantics",[]) as Array).has("unsupported_slave_semantic:AttackRange"));_check("guard_wander_is_executable",not ((slave["slaved_update"] as Dictionary).get("unsupported_semantics",[]) as Array).has("unsupported_slave_semantic:GuardWanderRange"));_check("presentation_receipted",((slave["slaved_update"] as Dictionary).get("unsupported_semantics",[]) as Array).has("presentation_binding:FadeTime"))
