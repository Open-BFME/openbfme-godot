	_check("physical_return_clears_beyond_guard_range",arrived_position.distance_to(arrived_guard)<=leash_local)
	_check("physical_return_keeps_target_cleared_and_does_not_repin",int(slave.get("target_id",99))==0 and Vector2(slave.get("destination",Vector2.ZERO)).is_equal_approx(return_point))
