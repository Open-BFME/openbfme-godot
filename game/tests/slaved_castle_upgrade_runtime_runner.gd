	slave["position"]=Vector2(100,100);slave["target_id"]=20;slave["order_kind"]="attack";var return_draws:=sim.logic_random_draws;sim._step_slaved_updates();_check("leash_clears_target",int(slave.get("target_id",99))==0);var return_point:=Vector2(slave.get("destination",Vector2.ZERO));_check("later_reroll_uses_guard_wander_radius",is_equal_approx(return_point.distance_to(first_guard),1.5));_check("return_consumes_exact_logic_rng_draw",sim.logic_random_draws==return_draws+1);var pinned_return_draws:=sim.logic_random_draws;sim._step_slaved_updates();_check("active_return_does_not_reroll_each_tick",sim.logic_random_draws==pinned_return_draws)
