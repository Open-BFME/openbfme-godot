	(sim.structures[50] as Dictionary)["health"]=0;sim._step_slaved_updates();_check("master_death_kills_authored_slave",int(slave.get("health",1))==0)
	var survivor:=sim.entities[11] as Dictionary;sim._attach_slaved_update_contract(survivor,_slave(false));sim.bind_slave(11,51);(sim.structures[51] as Dictionary)["health"]=0;sim._step_slaved_updates();_check("die_false_survives",int(survivor.get("health",0))>0);_check("die_false_unbinds",int((survivor["slaved_update"] as Dictionary).get("master_id",1))==0)
