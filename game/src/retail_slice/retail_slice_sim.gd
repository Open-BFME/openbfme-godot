	_step_structure_weapons()
	if ai_enabled and tick_index % AI_CONTROLLER_BASE_INTERVAL == 0:
		_update_ai_controllers()
	for id in entity_ids():
		_step_entity(id)
	_step_active_pickup_collisions()
