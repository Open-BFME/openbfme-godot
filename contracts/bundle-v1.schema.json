{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openbfme.bundle.v1",
  "title": "OpenBFME cooked bundle v1",
  "description": "Deterministic, faction-independent effective-INI data consumed by the simulation and presentation layers. Template array indexes are the ids published by snapshot-v1 objects.template.",
  "type": "object",
  "required": ["schema", "source", "templates", "weapons", "armors", "damage_fx", "locomotors", "locomotor_sets", "hordes", "defines", "diagnostics"],
  "additionalProperties": false,
  "$defs": {
    "scalar": {
      "type": ["string", "number", "boolean", "null"]
    },
    "fieldValue": {
      "oneOf": [
        { "$ref": "#/$defs/scalar" },
        {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/scalar" }
        }
      ]
    },
    "fields": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/fieldValue" }
    },
    "block": {
      "type": "object",
      "required": ["type", "tag", "fields", "blocks"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "fields": { "$ref": "#/$defs/fields" },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "module": {
      "type": "object",
      "required": ["carrier", "type", "tag", "fields", "blocks", "gap"],
      "additionalProperties": false,
      "properties": {
        "carrier": {
          "type": "string",
          "enum": ["Behavior", "Body", "Draw", "ClientUpdate", "ClientBehavior", "Flasher", "other"]
        },
        "type": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "fields": { "$ref": "#/$defs/fields" },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" },
          "description": "Ordered nested state and configuration blocks retained for lossless round trips."
        },
        "gap": {
          "type": "boolean",
          "description": "True only when the module block could not be parsed into typed fields because of a parse error, malformed block, or unknown carrier. Every well-formed module row is false regardless of runtime implementation; gap rows retain authored values verbatim."
        }
      }
    },
    "namedFields": {
      "type": "object",
      "required": ["name", "fields"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "fields": { "$ref": "#/$defs/fields" }
      }
    },
    "weaponNugget": {
      "type": "object",
      "required": ["kind", "fields"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["DamageNugget", "MetaImpactNugget", "ProjectileNugget", "other"]
        },
        "fields": { "$ref": "#/$defs/fields" }
      }
    },
    "armorEntry": {
      "type": "object",
      "required": ["damage_type", "percent"],
      "additionalProperties": false,
      "properties": {
        "damage_type": { "type": "string", "minLength": 1 },
        "percent": { "type": "number", "minimum": 0 }
      }
    },
    "rankInfo": {
      "type": "object",
      "required": ["rank", "unit_type", "position"],
      "additionalProperties": false,
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "unit_type": { "type": "string", "minLength": 1 },
        "position": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        }
      }
    }
  },
  "properties": {
    "schema": { "const": "openbfme.bundle.v1" },
    "source": {
      "type": "object",
      "required": ["effective_tree_sha256", "paths"],
      "additionalProperties": false,
      "properties": {
        "effective_tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the ordered virtual path and content-digest rows."
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "templates": {
      "type": "array",
      "description": "Ordered template table. An array index is the template id used by snapshot-v1.",
      "items": {
        "type": "object",
        "required": ["name", "kind", "parent", "kindof", "geometry", "fields", "blocks", "modules"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["object", "child", "reskin"] },
          "parent": { "type": ["string", "null"] },
          "side": { "type": "string", "minLength": 1, "description": "Authored SAGE Side/faction identifier." },
          "kindof": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "shape": { "type": "string", "minLength": 1 },
              "major_radius": { "type": "number" },
              "minor_radius": { "type": "number" },
              "height": { "type": "number" }
            }
          },
          "build_cost": { "type": "number" },
          "build_time": { "type": "number" },
          "command_points": { "type": "number" },
          "health": { "type": "number", "minimum": 0 },
          "fields": { "$ref": "#/$defs/fields", "description": "All authored top-level assignments, before inheritance." },
          "blocks": {
            "type": "array",
            "items": { "$ref": "#/$defs/block" },
            "description": "Ordered non-module blocks such as WeaponSet, retained before inheritance."
          },
          "modules": {
            "type": "array",
            "items": { "$ref": "#/$defs/module" }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "enum": ["child", "reskin"] } }, "required": ["kind"] },
            "then": { "properties": { "parent": { "type": "string", "minLength": 1 } } }
          }
        ]
      }
    },
    "weapons": {
      "type": "array",
      "description": "Ordered effective Weapon table in authored world units and milliseconds.",
      "items": {
        "type": "object",
        "required": ["name", "fields", "nuggets"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "fields": { "$ref": "#/$defs/fields" },
          "nuggets": {
            "type": "array",
            "items": { "$ref": "#/$defs/weaponNugget" }
          }
        }
      }
    },
    "armors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "entries", "fields"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "entries": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/armorEntry" }
          },
          "fields": {
            "$ref": "#/$defs/fields",
            "description": "Non-Armor assignments retained losslessly, such as DamageScalar."
          }
        }
      }
    },
    "damage_fx": {
      "type": "array",
      "items": { "$ref": "#/$defs/namedFields" }
    },
    "locomotors": {
      "type": "array",
      "description": "Ordered Locomotor assignments in retail world units; the runtime performs tick scaling.",
      "items": { "$ref": "#/$defs/namedFields" }
    },
    "locomotor_sets": {
      "type": "array",
      "description": "Authored Object LocomotorSet blocks in template and block order.",
      "items": { "$ref": "#/$defs/namedFields" }
    },
    "hordes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "rank_info", "fields"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "rank_info": {
            "type": "array",
            "items": { "$ref": "#/$defs/rankInfo" }
          },
          "fields": {
            "$ref": "#/$defs/fields",
            "description": "HordeContain-family assignments other than RankInfo, plus the bound locomotor's MaxTurnWithoutReform when authored."
          }
        }
      }
    },
    "defines": {
      "type": "object",
      "description": "Resolved effective #define constants. Numeric values are JSON numbers; other bodies remain authored strings.",
      "additionalProperties": { "$ref": "#/$defs/scalar" }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["template", "message"],
        "additionalProperties": false,
        "properties": {
          "template": { "type": "string" },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
