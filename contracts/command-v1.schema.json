{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openbfme.command.v1",
  "title": "OpenBFME command bundle v1",
  "description": "One seat's ordered command bundle for one simulation tick. Peers merge bundles by resolved team then seq; command array order is retained within a bundle.",
  "type": "object",
  "required": ["schema", "tick", "seat", "seq", "commands"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "openbfme.command.v1" },
    "tick": { "type": "integer", "minimum": 0 },
    "seat": { "type": "integer", "minimum": 0, "maximum": 7 },
    "seq": { "type": "integer", "minimum": 0 },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "args"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "move", "attack_move", "attack", "stop", "hold", "stance",
              "formation", "build", "train", "cancel", "ability", "rally",
              "sell", "garrison", "evacuate", "upgrade", "power"
            ]
          },
          "args": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "objects": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "integer", "minimum": 1 }
              },
              "object": { "type": "integer", "minimum": 1 },
              "target": { "type": "integer", "minimum": 1 },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "name": { "type": "string", "minLength": 1 },
              "template": { "type": "string", "minLength": 1 },
              "stance": { "type": "string", "minLength": 1 },
              "formation": { "type": "string", "minLength": 1 },
              "ability": { "type": "string", "minLength": 1 },
              "upgrade": { "type": "string", "minLength": 1 },
              "power": { "type": "string", "minLength": 1 },
              "index": { "type": "integer", "minimum": 0 },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
