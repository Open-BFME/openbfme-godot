extends SceneTree
func _initialize():
	var fs = ClassDB.instantiate("RetailFileSystem")
	assert(fs.mount_retail().ok)
	var world = ClassDB.instantiate("GameWorld")
	root.add_child(world)
	assert(world.setup(fs).ok)
	var cost_write = world.execute_lua("cost_ticket = bfme.buildingTypes['GondorBarracks']:set('cost', 600)")
	assert(cost_write.ok, cost_write.output)
	world.update_lua()
	var cost_read = world.execute_lua("return bfme.mutations.getStatus(cost_ticket), bfme.buildingTypes['GondorBarracks'].cost")
	assert(cost_read.ok and cost_read.output == "applied\t600\n", cost_read.output)
	var assignment = world.execute_lua("bfme.buildingTypes['GondorBarracks'].cost = 650")
	assert(assignment.ok, assignment.output)
	world.update_lua()
	var assigned_cost = world.execute_lua("return bfme.buildingTypes['GondorBarracks'].cost")
	assert(assigned_cost.ok and assigned_cost.output == "650\n", assigned_cost.output)
	assert(world.load_map("shellmap1", {"seed":0,"terrain":false}).ok)
	for value in [0.0,0.5,1.0,2.0,100.0]:
		var result = world.execute_lua("return bfme.match.setGameSpeed(%s)" % value)
		assert(result.ok,result.output)
		world.update_lua()
		assert(is_equal_approx(world.get_time_scale(),value))
	print("GAME SPEED INTEGRATION PASS")
	world.queue_free()
	quit()
