extends SceneTree
func _initialize() -> void: call_deferred("_run")
func _run() -> void:
	root.size = Vector2i(1280, 720)
	var fs = ClassDB.instantiate("RetailFileSystem")
	assert(fs.mount_retail().ok)
	var audio = ClassDB.instantiate("GameAudio")
	root.add_child(audio)
	assert(audio.boot(fs, {}).ok)
	var world = ClassDB.instantiate("GameWorld")
	root.add_child(world)
	assert(world.setup(fs).ok)
	assert(world.start_campaign_mission({"campaign":"GOOD_CAMPAIGN", "mission":0, "logic_thread":false}).ok)
	assert(world.attach_audio().ok)
	var camera := Camera3D.new()
	root.add_child(camera)
	var cine = load("res://scripts/campaign_cine.gd").new()
	root.add_child(cine)
	cine.dev_overlay = false
	cine.setup(world, camera, Vector3.ZERO, cine, audio)
	for i in 20:
		world.advance(0.2)
		cine._process(0.2)
		await process_frame
	var view: Dictionary = world.update_script_view(0, {})
	assert(not view.objectives.is_empty(), str(view))
	assert(view.objectives[0].index == 1)
	assert(view.objectives[0].text.length() > 8, str(view.objectives))
	assert(not view.objectives[0].text.begins_with("SCRIPT:"), str(view.objectives))
	assert(not cine._objectives_panel.visible)
	cine.toggle_objectives()
	cine._process(0)
	assert(cine._objectives_panel.visible)
	assert(cine._objectives.text.contains(view.objectives[0].text))
	var report: Dictionary = world.get_script_report()
	assert("MGRiven_ElfOfficer052" in report.audio_last, str(report))
	print("OBJECTIVE TEXT ", view.objectives[0].text)
	cine.queue_free()
	await process_frame
	assert(world.clear_game_data(false).ok)
	assert(world.start_campaign_mission({"campaign":"EVIL_CAMPAIGN", "mission":0, "logic_thread":false}).ok)
	var next_view: Dictionary = world.update_script_view(0, {})
	assert(not next_view.objectives.is_empty())
	assert(next_view.objectives[0].text != view.objectives[0].text)
	assert(not next_view.objectives[0].completed)
	print("CAMPAIGN OBJECTIVES AND VOICE PASS")
	world.queue_free()
	camera.queue_free()
	audio.queue_free()
	await process_frame
	quit()
