extends SceneTree
func _initialize() -> void:
	var world = ClassDB.instantiate("GameWorld")
	root.add_child(world)
	var loaded: Dictionary = world.execute_lua("bfme.console.reload()")
	assert(loaded.ok, loaded.output)
	var result: Dictionary = world.execute_lua("return controller.action('A',false),controller.action('A',true),#controller.ui.shortcuts")
	assert(result.ok and result.output == "accept\tcontextPrimary\t4\n",result.output)
	result=world.execute_lua("return controller.action('X',false),controller.action('X',true),controller.action('X',true,true)")
	assert(result.ok and result.output == "skirmish\tjumpToSelection\tsaveFavorites\n",result.output)
	result=world.execute_lua("return controller.action('B',true),controller.action('B',true,true),controller.action('B',false)")
	assert(result.ok and result.output == "deselect\trightPressCommand\tback\n",result.output)
	result=world.execute_lua("require('lib.keybinds').controller.menu.A='back'; return controller.action('A',false)")
	assert(result.ok and result.output == "back\n",result.output)
	assert(world.execute_lua("bfme.console.reload()").ok)
	result=world.execute_lua("return controller.action('A',false),#controller.ui.commands({1,2,3,4,5},4)")
	assert(result.ok and result.output == "accept\t4\n",result.output)
	result=world.execute_lua("return controller.action('Y',true),controller.action('LeftStick',true),controller.action('RightStick',true),controller.action('Y',true,true)")
	assert(result.ok and result.output == "VIEW_LAST_RADAR_EVENT\tVIEW_HOME_BASE\tCAMERA_RESET\tbackPalette\n",result.output)
	print("CONTROLLER LUA PASS")
	world.queue_free()
	quit()
