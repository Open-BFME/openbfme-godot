include_guard(GLOBAL)

set(OPENBFME_SANITIZE "OFF" CACHE STRING "Sanitizers: OFF, address, undefined, address,undefined, or thread")
set_property(CACHE OPENBFME_SANITIZE PROPERTY STRINGS OFF address undefined "address,undefined" thread)
if(NOT OPENBFME_SANITIZE)
    return()
endif()

string(REPLACE "," ";" _openbfme_sanitizers "${OPENBFME_SANITIZE}")
foreach(_sanitizer IN LISTS _openbfme_sanitizers)
    if(NOT _sanitizer MATCHES "^(address|undefined|thread)$")
        message(FATAL_ERROR "Unknown OPENBFME_SANITIZE entry '${_sanitizer}'; use address, undefined, or thread")
    endif()
endforeach()
if("thread" IN_LIST _openbfme_sanitizers AND "address" IN_LIST _openbfme_sanitizers)
    message(FATAL_ERROR "ThreadSanitizer and AddressSanitizer require separate builds")
endif()
if(MSVC OR NOT CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang)$")
    message(FATAL_ERROR "OPENBFME_SANITIZE requires a GCC or Clang driver")
endif()
list(REMOVE_DUPLICATES _openbfme_sanitizers)
list(JOIN _openbfme_sanitizers "," _openbfme_sanitizer_flags)
add_compile_options("-fsanitize=${_openbfme_sanitizer_flags}" -fno-omit-frame-pointer -g)
add_link_options("-fsanitize=${_openbfme_sanitizer_flags}")
