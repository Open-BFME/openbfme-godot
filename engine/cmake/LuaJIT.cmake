# LuaJIT 2.1 (lane LUAGD-1): the VM of lua-gdextension and of the bfme.* API (BfmeLuaRuntime). Retail scripts still use Lua 4.
#
#   thirdparty/luajit-<commit>/   the pristine upstream tree (git archive of the commit lua-gdextension 0.8.2 pins; never edited)
#   src/Libraries/LuaJIT/         prefix.h (tools/luajit_prefix.py: LuaJIT's lua_* / luaL_* / luaopen_* names renamed objit_*, so
#                                 they cannot bind to the retail Lua 4 VM linked into the same library) and README.md
#
# LuaJIT builds with its own makefile (macOS, Linux, iOS) or msvcbuild.bat (Windows, MSVC): its interpreter is generated by a
# host tool (buildvm), which those scripts drive. The build copies the tree into the build folder first (both scripts build
# in place). cmake/LuaJITBuild.cmake runs the copy and the build; its result is the static library below.
file(GLOB OPENBFME_LUAJIT_DIRS LIST_DIRECTORIES true ${CMAKE_CURRENT_SOURCE_DIR}/thirdparty/luajit-*)
list(LENGTH OPENBFME_LUAJIT_DIRS OPENBFME_LUAJIT_COUNT)
if(NOT OPENBFME_LUAJIT_COUNT EQUAL 1)
    message(FATAL_ERROR "expected one thirdparty/luajit-* folder, found: ${OPENBFME_LUAJIT_DIRS}")
endif()
set(OPENBFME_LUAJIT_PRISTINE ${OPENBFME_LUAJIT_DIRS})
set(OPENBFME_LUAJIT_PREFIX ${CMAKE_CURRENT_SOURCE_DIR}/src/Libraries/LuaJIT/prefix.h)
set(OPENBFME_LUAJIT_WORK ${CMAKE_CURRENT_BINARY_DIR}/luajit)
if(MSVC)
    set(OPENBFME_LUAJIT_LIB ${OPENBFME_LUAJIT_WORK}/src/lua51.lib)
else()
    set(OPENBFME_LUAJIT_LIB ${OPENBFME_LUAJIT_WORK}/src/libluajit.a)
endif()

# the target of the build: the system LuaJIT's makefile knows, the compiler and its flags
set(OPENBFME_LUAJIT_SYS "")
set(OPENBFME_LUAJIT_FLAGS "")
set(OPENBFME_LUAJIT_HOST_SYSROOT "")
if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
    set(OPENBFME_LUAJIT_SYS iOS)
    # the host tools (minilua, buildvm) run on this Mac: the macOS SDK for them (build_ios.sh exports SDKROOT as the iOS one)
    execute_process(COMMAND xcrun --sdk macosx --show-sdk-path OUTPUT_VARIABLE OPENBFME_LUAJIT_HOST_SYSROOT
                    OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    set(OPENBFME_LUAJIT_FLAGS "-isysroot ${CMAKE_OSX_SYSROOT}")
    if(OPENBFME_IOS_SDK STREQUAL "iphonesimulator")
        string(APPEND OPENBFME_LUAJIT_FLAGS " -mios-simulator-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}")
    else()
        string(APPEND OPENBFME_LUAJIT_FLAGS " -miphoneos-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}")
    endif()
elseif(APPLE)
    set(OPENBFME_LUAJIT_SYS Darwin)
    if(CMAKE_OSX_SYSROOT)
        set(OPENBFME_LUAJIT_FLAGS "-isysroot ${CMAKE_OSX_SYSROOT}")
    endif()
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(OPENBFME_LUAJIT_SYS Linux)
    set(OPENBFME_LUAJIT_FLAGS "-fPIC") # linked into the shared GDExtension
elseif(NOT MSVC)
    message(FATAL_ERROR "LuaJIT: no build recipe for ${CMAKE_SYSTEM_NAME} with this compiler")
endif()
if(APPLE)
    set(OPENBFME_LUAJIT_ARCHS ${CMAKE_OSX_ARCHITECTURES})
    if(NOT OPENBFME_LUAJIT_ARCHS)
        set(OPENBFME_LUAJIT_ARCHS ${CMAKE_HOST_SYSTEM_PROCESSOR})
    endif()
    list(LENGTH OPENBFME_LUAJIT_ARCHS OPENBFME_LUAJIT_ARCH_COUNT)
    if(NOT OPENBFME_LUAJIT_ARCH_COUNT EQUAL 1)
        message(FATAL_ERROR "LuaJIT: one architecture per build (CMAKE_OSX_ARCHITECTURES is ${OPENBFME_LUAJIT_ARCHS})")
    endif()
    string(APPEND OPENBFME_LUAJIT_FLAGS " -arch ${OPENBFME_LUAJIT_ARCHS}")
endif()

file(GLOB_RECURSE OPENBFME_LUAJIT_INPUTS CONFIGURE_DEPENDS ${OPENBFME_LUAJIT_PRISTINE}/src/*)
add_custom_command(
    OUTPUT ${OPENBFME_LUAJIT_LIB}
    COMMAND ${CMAKE_COMMAND}
            -DPRISTINE=${OPENBFME_LUAJIT_PRISTINE} -DWORK=${OPENBFME_LUAJIT_WORK} -DPREFIX=${OPENBFME_LUAJIT_PREFIX}
            -DMSVC_BUILD=${MSVC} -DTARGET_SYS=${OPENBFME_LUAJIT_SYS} "-DCC=${CMAKE_C_COMPILER}" "-DTARGET_FLAGS=${OPENBFME_LUAJIT_FLAGS}"
            -DDEPLOYMENT_TARGET=${CMAKE_OSX_DEPLOYMENT_TARGET} -DHOST_SYSROOT=${OPENBFME_LUAJIT_HOST_SYSROOT}
            -P ${CMAKE_CURRENT_SOURCE_DIR}/cmake/LuaJITBuild.cmake
    DEPENDS ${OPENBFME_LUAJIT_INPUTS} ${OPENBFME_LUAJIT_PREFIX} ${CMAKE_CURRENT_SOURCE_DIR}/cmake/LuaJITBuild.cmake
    COMMENT "Building LuaJIT (${OPENBFME_LUAJIT_PRISTINE})"
    VERBATIM)
add_custom_target(openbfme_luajit_build DEPENDS ${OPENBFME_LUAJIT_LIB})

add_library(openbfme_luajit STATIC IMPORTED GLOBAL)
set_target_properties(openbfme_luajit PROPERTIES IMPORTED_LOCATION ${OPENBFME_LUAJIT_LIB})
# the headers come from the build copy (luajit.h is generated there, from luajit_rolling.h and .relver), as <luajit/lua.h> ...: the
# engine core also sees the retail Lua 4 headers. lua-gdextension and sol2 include <lua.h>: their target adds include/luajit itself
set(OPENBFME_LUAJIT_INCLUDE ${OPENBFME_LUAJIT_WORK}/include)
file(MAKE_DIRECTORY ${OPENBFME_LUAJIT_INCLUDE}/luajit)
target_include_directories(openbfme_luajit INTERFACE ${OPENBFME_LUAJIT_INCLUDE})
add_dependencies(openbfme_luajit openbfme_luajit_build)
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    target_link_libraries(openbfme_luajit INTERFACE m dl)
endif()

# every translation unit that includes a LuaJIT header is compiled with the prefix first
function(openbfme_luajit_prefix target)
    if(MSVC)
        target_compile_options(${target} PRIVATE "/FI${OPENBFME_LUAJIT_PREFIX}")
    else()
        target_compile_options(${target} PRIVATE "SHELL:-include ${OPENBFME_LUAJIT_PREFIX}")
    endif()
    target_compile_definitions(${target} PRIVATE LUAJIT_ENABLE_LUA52COMPAT)
endfunction()
