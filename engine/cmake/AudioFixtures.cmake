# Included only when OPENBFME_BUILD_TESTS is enabled. Fixture bytes never enter git.
set(_audio_default "${CMAKE_BINARY_DIR}/audio_fixtures")
if(NOT "$ENV{OPENBFME_AUDIO_FIXTURES}" STREQUAL "")
    set(_audio_default "$ENV{OPENBFME_AUDIO_FIXTURES}")
endif()
set(OPENBFME_AUDIO_FIXTURES "${_audio_default}" CACHE PATH "Directory of generated reference MP3 fixtures")
get_filename_component(OPENBFME_AUDIO_FIXTURE_DIR "${OPENBFME_AUDIO_FIXTURES}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/..")
get_filename_component(_audio_generator "${CMAKE_CURRENT_SOURCE_DIR}/../tools/audio/gen_mp3_fixtures.py" ABSOLUTE)
if(CMAKE_HOST_WIN32)
    set(_audio_python "py -3")
else()
    set(_audio_python "python3")
endif()
set(_audio_manual "${_audio_python} \"${_audio_generator}\" --out \"${OPENBFME_AUDIO_FIXTURE_DIR}\"")
set(_audio_error "")
set(_audio_check "${CMAKE_CURRENT_LIST_DIR}/CheckAudioFixtures.cmake")
set(_audio_command "${CMAKE_COMMAND}" "-DFIXTURES=${OPENBFME_AUDIO_FIXTURE_DIR}"
    "-DMANIFEST=${CMAKE_CURRENT_SOURCE_DIR}/tests/data/audio/mp3_fixtures.tsv"
    "-DGOLDEN=${CMAKE_CURRENT_SOURCE_DIR}/tests/data/audio/mp3_golden.tsv" -P "${_audio_check}")
execute_process(COMMAND ${_audio_command}
    RESULT_VARIABLE _audio_result OUTPUT_VARIABLE _audio_output ERROR_VARIABLE _audio_stderr)
if(NOT _audio_result STREQUAL "0")
    string(REGEX MATCH "MP3 fixture [^\r\n]*" _audio_check_reason "${_audio_stderr}")
    if(NOT _audio_check_reason)
        set(_audio_check_reason "MP3 reference fixtures absent or invalid")
    endif()
    if(OPENBFME_LAME STREQUAL "OFF")
        set(_audio_error "${_audio_check_reason} (regeneration disabled by OPENBFME_LAME=OFF)")
    else()
        find_package(Python3 QUIET COMPONENTS Interpreter)
        if(NOT Python3_FOUND)
            string(APPEND _audio_error "Missing MP3 fixture tool: Python3 interpreter\n")
        endif()
        find_program(OPENBFME_LAME lame)
        find_program(OPENBFME_MPG123 mpg123)
        foreach(_tool LAME MPG123)
            if(NOT OPENBFME_${_tool})
                string(TOLOWER "${_tool}" _name)
                string(APPEND _audio_error "Missing MP3 fixture tool: ${_name}\n")
            endif()
        endforeach()
        if(OPENBFME_LAME)
            execute_process(COMMAND "${OPENBFME_LAME}" --version RESULT_VARIABLE _lame_result
                OUTPUT_VARIABLE _lame_banner ERROR_VARIABLE _lame_stderr)
            string(REGEX MATCH "[Vv]ersion[ \t]+([0-9]+([.][0-9]+)+)" _lame_match "${_lame_banner}${_lame_stderr}")
            set(_lame_version "${CMAKE_MATCH_1}")
            if(NOT _lame_result STREQUAL "0" OR NOT _lame_match)
                string(APPEND _audio_error "Cannot determine lame version; fixtures need 3.100\n")
            elseif(NOT _lame_version STREQUAL "3.100")
                string(APPEND _audio_error "lame ${_lame_version} found, fixtures need 3.100\n")
            endif()
        endif()
        set(_audio_command "${Python3_EXECUTABLE}" "${_audio_generator}" --out "${OPENBFME_AUDIO_FIXTURE_DIR}"
            --lame "${OPENBFME_LAME}" --mpg123 "${OPENBFME_MPG123}")
        if(NOT _audio_error)
            execute_process(
                COMMAND ${_audio_command}
                RESULT_VARIABLE _audio_result OUTPUT_VARIABLE _audio_output ERROR_VARIABLE _audio_stderr)
            if(NOT _audio_result STREQUAL "0")
                set(_audio_error "MP3 fixture generation/validation failed:\n${_audio_output}${_audio_stderr}")
            endif()
        endif()
    endif()
endif()
if(_audio_error)
    string(CONCAT _audio_diagnostic "MP3 fixtures need lame 3.100 and mpg123: ${_audio_error}\n"
        "Generate outside the CMake sandbox: ${_audio_manual}\n"
        "Exactly the five MP3 audio test cases will FAIL until the reference fixtures validate; no tests are skipped.")
    message(WARNING "${_audio_diagnostic}")
else()
    message(STATUS "MP3 reference fixtures validated: ${OPENBFME_AUDIO_FIXTURE_DIR}")
    set(_audio_diagnostic "")
endif()
set(_audio_status_file "${CMAKE_CURRENT_BINARY_DIR}/audio_fixtures_status.txt")
file(WRITE "${_audio_status_file}" "${_audio_error}\n")
set_source_files_properties(tests/test_audio_decode.cpp PROPERTIES COMPILE_DEFINITIONS
    "OPENBFME_AUDIO_STATUS_FILE=\"${_audio_status_file}\";OPENBFME_AUDIO_GENERATOR=\"${_audio_generator}\"")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_audio_generator}" "${_audio_check}"
    "${CMAKE_CURRENT_SOURCE_DIR}/tests/data/audio/mp3_golden.tsv"
    "${CMAKE_CURRENT_SOURCE_DIR}/tests/data/audio/mp3_fixtures.tsv")
