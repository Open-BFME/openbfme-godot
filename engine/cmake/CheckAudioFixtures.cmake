# Native validation lets pre-generated fixtures work without Python or audio tools.
file(STRINGS "${MANIFEST}" _rows REGEX "^[^#]")
file(STRINGS "${GOLDEN}" _golden_rows REGEX "^[^#]")
set(_names "")
foreach(_row IN LISTS _rows)
    string(REPLACE "\t" ";" _fields "${_row}")
    list(LENGTH _fields _count)
    if(NOT _count EQUAL 3)
        message(FATAL_ERROR "Invalid MP3 fixture manifest row: ${_row}")
    endif()
    list(GET _fields 0 _name)
    list(GET _fields 1 _size)
    list(GET _fields 2 _sha256)
    list(APPEND _names "${_name}")
    set(_path "${FIXTURES}/${_name}.mp3.bin")
    if(NOT EXISTS "${_path}" OR IS_DIRECTORY "${_path}")
        message(FATAL_ERROR "MP3 fixture missing or unreadable: ${_path}")
    endif()
    file(SIZE "${_path}" _actual_size)
    file(SHA256 "${_path}" _actual_sha256)
    if(NOT _actual_size STREQUAL _size OR NOT _actual_sha256 STREQUAL _sha256)
        message(FATAL_ERROR "MP3 fixture size/SHA-256 mismatch for ${_name}")
    endif()
endforeach()
set(_golden_names "")
foreach(_row IN LISTS _golden_rows)
    string(REGEX REPLACE "\t.*" "" _name "${_row}")
    list(APPEND _golden_names "${_name}")
endforeach()
if(NOT _names OR NOT _names STREQUAL _golden_names)
    message(FATAL_ERROR "MP3 fixture names differ between mp3_fixtures.tsv and mp3_golden.tsv")
endif()
list(LENGTH _names _count)
message(STATUS "Verified ${_count} MP3 fixtures (sizes and SHA-256)")
