<Window x:Class="OpenBFME.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenBFME"
        Width="1100" Height="680"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="Manual"
        Background="#0B0B0C"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/openbfme-mark.png"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0B0B0C"/>
    <SolidColorBrush x:Key="BgElevated" Color="#141416"/>
    <SolidColorBrush x:Key="BgCard" Color="#1A1A1D"/>
    <SolidColorBrush x:Key="BgHover" Color="#242428"/>
    <SolidColorBrush x:Key="Line" Color="#2A2A30"/>
    <SolidColorBrush x:Key="Text" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="TextDim" Color="#9A9AA3"/>
    <SolidColorBrush x:Key="Accent" Color="#C9A227"/>
    <SolidColorBrush x:Key="AccentDim" Color="#6B5614"/>
    <SolidColorBrush x:Key="Play" Color="#2D6A4F"/>
    <SolidColorBrush x:Key="PlayHover" Color="#40916C"/>
    <SolidColorBrush x:Key="DangerBg" Color="#2A1515"/>
    <SolidColorBrush x:Key="DangerLine" Color="#7A3030"/>

    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource BgHover}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
      <Setter Property="Background" Value="{StaticResource BgCard}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinWidth" Value="100"/>
    </Style>

    <Style x:Key="PlayBtn" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Play}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="52"/>
      <Setter Property="MinWidth" Value="200"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    CornerRadius="8" Padding="28,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource PlayHover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#101012"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
      <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Background" Value="#1E1E22"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid SnapsToDevicePixels="True">
              <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
              <Border x:Name="PART_Track"/>
              <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                <Border Background="{TemplateBinding Foreground}" CornerRadius="3" MinWidth="0"/>
              </Decorator>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top bar -->
    <Border Grid.Row="0" Background="{StaticResource BgElevated}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,0">
      <DockPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="pack://application:,,,/Assets/openbfme-mark.png"
                 Width="28" Height="28" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 Margin="0,0,12,0" VerticalAlignment="Center"
                 ToolTip="OpenBFME"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="OPENBFME" FontSize="15" FontWeight="Bold"
                       Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
            <TextBlock x:Name="VersionText" Text="Not installed" Margin="0,1,0,0"
                       Foreground="{StaticResource TextDim}" FontSize="11"/>
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="UpdateButton" Content="Update" Style="{StaticResource IconBtn}"
                  Click="Update_Click" ToolTip="Check for engine update"/>
          <Button x:Name="SettingsButton" Content="Settings" Style="{StaticResource IconBtn}"
                  Click="Settings_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main: hero + feed -->
    <Grid Grid.Row="1" Margin="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*"/>
        <ColumnDefinition Width="1*"/>
      </Grid.ColumnDefinitions>

      <!-- Left hero with brand banner + atmosphere -->
      <Border Grid.Column="0" ClipToBounds="True">
        <Grid>
          <!-- Atmospheric background (generated; no retail art) -->
          <Image Source="pack://application:,,,/Assets/launcher-hero-bg.png"
                 Stretch="UniformToFill"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 Opacity="0.55"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <!-- Brand README banner strip across the top of the hero -->
          <Image Source="pack://application:,,,/Assets/openbfme-banner.png"
                 Stretch="UniformToFill"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 Opacity="0.72"
                 VerticalAlignment="Top" Height="168"
                 HorizontalAlignment="Center"/>
          <!-- Readability scrims -->
          <Border>
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#E60B0B0C" Offset="0"/>
                <GradientStop Color="#990B0B0C" Offset="0.28"/>
                <GradientStop Color="#CC0B0B0C" Offset="0.55"/>
                <GradientStop Color="#F20B0B0C" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Border Padding="40,36">
            <DockPanel LastChildFill="False">
              <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <Image Source="pack://application:,,,/Assets/openbfme-mark.png"
                         Width="40" Height="40" Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="HighQuality"
                         Margin="0,0,14,0" VerticalAlignment="Center"/>
                  <TextBlock Text="OPENBFME" FontSize="40" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="SubtitleText"
                           Text="Rise of the Witch-king · modern engine"
                           Foreground="{StaticResource TextDim}" FontSize="14" Margin="0,8,0,0"/>
                <TextBlock x:Name="ReleaseCandidateText" Text=""
                           Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,18,0,0"
                           TextWrapping="Wrap"/>
              </StackPanel>

              <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,32,0,0">
                <Button x:Name="PlayButton" Content="PLAY" Style="{StaticResource PlayBtn}"
                        Click="Play_Click" HorizontalAlignment="Left"/>
                <TextBlock x:Name="StatusText" Text="Ready" Margin="0,14,0,8"
                           Foreground="{StaticResource TextDim}" FontSize="12" TextWrapping="Wrap"/>
                <ProgressBar x:Name="Progress" Minimum="0" Maximum="100"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button x:Name="SetupAllButton" Content="Get ready" Style="{StaticResource SecondaryBtn}"
                          Click="SetupAll_Click" ToolTip="Download game files and check for updates"/>
                  <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryBtn}"
                          Click="Cancel_Click" IsEnabled="False"/>
                </StackPanel>
                <Border x:Name="DetailPanel" Visibility="Collapsed" Margin="0,12,0,0"
                        Background="{StaticResource DangerBg}" BorderBrush="{StaticResource DangerLine}"
                        BorderThickness="1" CornerRadius="6" Padding="12,10">
                  <TextBlock x:Name="DetailText" TextWrapping="Wrap" FontSize="12"
                             Foreground="#F0C8C8"/>
                </Border>
              </StackPanel>
            </DockPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Right: content packs + news -->
      <Border Grid.Column="1" Background="{StaticResource Bg}"
              BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="20,20">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="1.35*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Content packs / mods -->
          <DockPanel Grid.Row="0">
            <DockPanel DockPanel.Dock="Top" Margin="4,0,0,10">
              <StackPanel>
                <TextBlock Text="ASSET PACKS &amp; MODS"
                           FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDim}"/>
                <TextBlock x:Name="PacksSourceText" Text="Scanning…" FontSize="11"
                           Foreground="{StaticResource TextDim}" Margin="0,3,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource IconBtn}"
                      Click="RefreshPacks_Click" HorizontalAlignment="Right"
                      VerticalAlignment="Top" ToolTip="Rescan installed packs and mods"/>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="PacksFeed">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource BgCard}" CornerRadius="8"
                            Padding="14,12" Margin="0,0,0,8"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                          <Button Content="Set active" Style="{StaticResource SecondaryBtn}"
                                  Margin="0" MinWidth="88" Padding="10,6"
                                  Visibility="{Binding SetActiveVisible}"
                                  Tag="{Binding RelativeKey}"
                                  Click="SetActivePack_Click"
                                  ToolTip="Write selection.json so Play mounts this pack"/>
                        </StackPanel>
                        <StackPanel>
                          <DockPanel Margin="0,0,0,4">
                            <Border Background="{StaticResource AccentDim}" CornerRadius="3"
                                    Padding="7,2" DockPanel.Dock="Left" Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                              <TextBlock Text="{Binding Role}" FontSize="10" FontWeight="Bold"
                                         Foreground="{StaticResource Accent}"/>
                            </Border>
                            <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                       Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" DockPanel.Dock="Right"
                                       Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource Text}" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                          </DockPanel>
                          <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                     Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>

          <Border Grid.Row="1" Height="1" Background="{StaticResource Line}" Margin="0,12,0,12"/>

          <!-- News / patch feed -->
          <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Text="NEWS &amp; PATCHES"
                       FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDim}"
                       Margin="4,0,0,10"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="NewsFeed">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource BgCard}" CornerRadius="8"
                            Padding="16,14" Margin="0,0,0,10"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                      <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                          <Border Background="{StaticResource AccentDim}" CornerRadius="3"
                                  Padding="8,2" DockPanel.Dock="Left" Margin="0,0,10,0"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding Tag}" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}"/>
                          </Border>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                     Foreground="{StaticResource Text}" TextWrapping="Wrap"
                                     VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Body}" FontSize="12"
                                   Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                                   LineHeight="18"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Footer status chips (compact) -->
    <Border Grid.Row="2" Background="{StaticResource BgElevated}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,10">
      <DockPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="CheckEngineText" Text="Engine —" FontSize="11"
                     Foreground="{StaticResource TextDim}" Margin="0,0,16,0"/>
          <TextBlock x:Name="CheckReleaseText" Text="Release —" FontSize="11"
                     Foreground="{StaticResource TextDim}" Margin="0,0,16,0"/>
          <TextBlock x:Name="CheckBfmeText" Text="BFME II —" FontSize="11"
                     Foreground="{StaticResource TextDim}" Margin="0,0,16,0"/>
          <TextBlock x:Name="CheckRotwkText" Text="RotWK —" FontSize="11"
                     Foreground="{StaticResource TextDim}" Margin="0,0,16,0"/>
          <TextBlock x:Name="CheckPacksText" Text="Packs —" FontSize="11"
                     Foreground="{StaticResource TextDim}"/>
        </StackPanel>
        <TextBlock x:Name="ChannelText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                   FontSize="11" Foreground="{StaticResource TextDim}"/>
      </DockPanel>
    </Border>

    <!-- Settings overlay -->
    <Border x:Name="SettingsOverlay" Grid.RowSpan="3" Visibility="Collapsed"
            Background="#CC0B0B0C">
      <Border Width="520" MaxWidth="560" HorizontalAlignment="Right"
              Background="{StaticResource BgElevated}"
              BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="28,24">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource IconBtn}"
                    Click="Settings_Click" HorizontalAlignment="Right"/>
          </DockPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="RELEASE CHANNEL" FontSize="11" FontWeight="Bold"
                         Foreground="{StaticResource TextDim}" Margin="0,0,0,10"/>
              <TextBlock Text="Channel" FontSize="12" Margin="0,0,0,6"/>
              <ComboBox x:Name="ChannelSelector" SelectionChanged="ChannelSelector_SelectionChanged"
                        Margin="0,0,0,6">
                <ComboBoxItem Content="Stable" Tag="stable"/>
                <ComboBoxItem Content="Playtest" Tag="playtest"/>
                <ComboBoxItem Content="Nightly" Tag="nightly"/>
              </ComboBox>
              <TextBlock x:Name="ChannelWarningText" FontSize="11"
                         Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                         Margin="0,0,0,18"/>

              <TextBlock Text="GAME FILES" FontSize="11" FontWeight="Bold"
                         Foreground="{StaticResource TextDim}" Margin="0,0,0,10"/>

              <TextBlock Text="BFME II folder" FontSize="12" Margin="0,0,0,6"/>
              <TextBox x:Name="BfmePath" Margin="0,0,0,4"/>
              <TextBlock x:Name="BfmeDetectText" FontSize="11" Foreground="{StaticResource TextDim}"
                         TextWrapping="Wrap" Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Button x:Name="BrowseBfmeButton" Content="Browse" Style="{StaticResource SecondaryBtn}"
                        Click="BrowseBfme_Click"/>
                <Button x:Name="DownloadBfmeButton" Content="Download" Style="{StaticResource SecondaryBtn}"
                        Click="DownloadBfme_Click"/>
                <Button x:Name="ImportBfmeButton" Content="Convert" Style="{StaticResource SecondaryBtn}"
                        Click="ImportBfme_Click"/>
              </StackPanel>

              <TextBlock Text="RotWK folder" FontSize="12" Margin="0,0,0,6"/>
              <TextBox x:Name="RotwkPath" Margin="0,0,0,4"/>
              <TextBlock x:Name="RotwkDetectText" FontSize="11" Foreground="{StaticResource TextDim}"
                         TextWrapping="Wrap" Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                <Button x:Name="BrowseRotwkButton" Content="Browse" Style="{StaticResource SecondaryBtn}"
                        Click="BrowseRotwk_Click"/>
                <Button x:Name="DownloadRotwkButton" Content="Download" Style="{StaticResource SecondaryBtn}"
                        Click="DownloadRotwk_Click"/>
                <Button x:Name="ImportRotwkButton" Content="Convert" Style="{StaticResource SecondaryBtn}"
                        Click="ImportRotwk_Click"/>
              </StackPanel>

              <TextBlock Text="ASSET PACKS &amp; MODS" FontSize="11" FontWeight="Bold"
                         Foreground="{StaticResource TextDim}" Margin="0,0,0,10"/>
              <TextBlock Text="Content root (OPENBFME_CONTENT)" FontSize="12" Margin="0,0,0,6"/>
              <TextBox x:Name="ContentRootPath" Margin="0,0,0,4"/>
              <TextBlock x:Name="ContentRootNote" FontSize="11" Foreground="{StaticResource TextDim}"
                         TextWrapping="Wrap" Margin="0,0,0,8"
                         Text="Play mounts packs from this folder. Leave as detected, or browse to another content-packs root."/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="BrowseContentRootButton" Content="Browse" Style="{StaticResource SecondaryBtn}"
                        Click="BrowseContentRoot_Click"/>
                <Button x:Name="OpenContentRootButton" Content="Open folder" Style="{StaticResource SecondaryBtn}"
                        Click="OpenContentRoot_Click"/>
                <Button x:Name="RefreshPacksSettingsButton" Content="Rescan" Style="{StaticResource SecondaryBtn}"
                        Click="RefreshPacks_Click"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="OpenModsButton" Content="Open mods folder" Style="{StaticResource SecondaryBtn}"
                        Click="OpenMods_Click"
                        ToolTip="Creates install-root/mods if needed (loose pack.json mods)"/>
                <Button x:Name="OpenInstallButton" Content="Open install folder" Style="{StaticResource SecondaryBtn}"
                        Click="OpenInstall_Click"/>
              </StackPanel>
              <TextBlock x:Name="PacksSettingsSummary" FontSize="11" Foreground="{StaticResource TextDim}"
                         TextWrapping="Wrap" Margin="0,0,0,18"/>

              <TextBlock Text="LAUNCH" FontSize="11" FontWeight="Bold"
                         Foreground="{StaticResource TextDim}" Margin="0,0,0,10"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="PlayFromSettingsButton" Content="Play" Style="{StaticResource SecondaryBtn}"
                        Click="Play_Click" ToolTip="Launch with the paths and content root above"/>
                <Button x:Name="VerifyEngineButton" Content="Verify engine" Style="{StaticResource SecondaryBtn}"
                        Click="VerifyEngine_Click"/>
                <Button x:Name="OpenGameFolderButton" Content="Game folder" Style="{StaticResource SecondaryBtn}"
                        Click="OpenGameFolder_Click"
                        ToolTip="Open the installed OpenBFME version folder"/>
              </StackPanel>
              <TextBlock FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                         Margin="0,0,0,18"
                         Text="Launch uses OPENBFME_CONTENT for asset packs, plus BFME2_INSTALL / ROTWK_INSTALL when retail folders are set."/>

              <TextBlock Text="ADVANCED" FontSize="11" FontWeight="Bold"
                         Foreground="{StaticResource TextDim}" Margin="0,0,0,10"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="RollbackButton" Content="Roll back engine" Style="{StaticResource SecondaryBtn}"
                        Click="Rollback_Click"/>
                <Button x:Name="OpenAioButton" Content="All-in-One" Style="{StaticResource SecondaryBtn}"
                        Click="OpenAio_Click"/>
              </StackPanel>
              <TextBlock x:Name="AioStatusText" FontSize="11" Foreground="{StaticResource TextDim}"
                         TextWrapping="Wrap" Margin="0,0,0,16"/>

              <TextBlock Text="DIAGNOSTICS" FontSize="11" FontWeight="Bold"
                         Foreground="{StaticResource TextDim}" Margin="0,0,0,10"/>
              <CheckBox x:Name="DiagnosticsToggle" Foreground="{StaticResource TextDim}" FontSize="12"
                        Margin="0,0,0,8" Click="DiagnosticsToggle_Click"
                        Content="Record detailed diagnostics while playing"
                        ToolTip="Off by default. When on, the game records which content pack it mounted and why, plus errors, into a run log the button below collects."/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="ExportBugReportButton" Content="Export bug report" Style="{StaticResource SecondaryBtn}"
                        Click="ExportBugReport_Click"
                        ToolTip="Collect the most recent launcher, game and conversion logs into one zip you can send back"/>
                <Button x:Name="OpenLogsButton" Content="Open logs folder" Style="{StaticResource SecondaryBtn}"
                        Click="OpenLogs_Click"/>
              </StackPanel>
              <TextBlock FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                         Margin="0,0,0,16"
                         Text="The bug report zip contains only log documents: no game files, no converted assets, no passwords, and your home folder name is replaced before anything is written."/>

              <TextBlock FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                         Text="OpenBFME is code-only. You need a legal BFME II / RotWK install (or download game files here). Converted packs stay private on this machine. Nothing is uploaded."/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</Window>
