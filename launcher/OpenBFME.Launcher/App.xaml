<Application x:Class="OpenBFME.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <!-- Keep app-level resources minimal. Window owns the BFME II chrome styles so
       we never fight a second global Button template that can break painting. -->
  <Application.Resources>
    <SolidColorBrush x:Key="Gold" Color="#D4AF37"/>
    <SolidColorBrush x:Key="Panel" Color="#14100C"/>
  </Application.Resources>
</Application>
