<Application x:Class="OpenBFME.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Gold" Color="#D5B66F"/>
    <SolidColorBrush x:Key="Panel" Color="#1D2525"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#34453E"/>
      <Setter Property="Foreground" Value="#F4E8C8"/>
      <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Application.Resources>
</Application>
