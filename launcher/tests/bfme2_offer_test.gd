## Asset-free BFME2-only package, launch arguments and remembered-folder regression.
extends SceneTree
const Aio := preload("res://scripts/core/aio_install.gd")
const Updater := preload("res://scripts/core/updater.gd")
const BuildInfo := preload("res://scripts/core/build_info.gd")
const Paths := preload("res://scripts/ui/paths.gd")
const PlayScreen := preload("res://scripts/ui/play_screen.gd")
var failed := false
func check(ok: bool, message: String) -> void:
	if not ok:
		failed = true
		push_error(message)
func _initialize() -> void:
	call_deferred("run")
func run() -> void:
	var folder := OS.get_environment("OPENBFME_TEST_ROOT")
	DirAccess.make_dir_recursive_absolute(folder)
	OS.set_environment("OPENBFME_GAME_USER_DIR", folder)
	var updater := Updater.new(BuildInfo.new())
	updater.state = ConfigFile.new()
	var aio := Aio.new(updater)
	check(aio.choice == Aio.GAMES, "RotWK pair remains the default download")
	check(aio.chosen().size() == 2, "default download includes both games")
	check(aio.choose(Aio.BFME2_ONLY).is_empty(), "BFME2-only selection is accepted")
	check(aio.chosen().size() == 1 and aio.chosen()[0].key == "bfme2", "BFME2-only fetches no RotWK package")
	updater.state.set_value("launcher", "game", "bfme2-106")
	var args: Dictionary = updater.game_arguments()
	check(args.ok and "--game=bfme2-106" in args.args, "Play selects the explicit BFME2 mount")
	updater.state.set_value("launcher", "game", "bfme2")
	args = updater.game_arguments()
	check(args.ok and "--game=bfme2" in args.args and not "--game=bfme2-106" in args.args, "switching back explicitly selects RotWK")
	var picker := PlayScreen.new()
	check(picker.game_picker.selected == 0, "RotWK remains the first selected game")
	check(picker.game_picker.item_count == 3, "BFME2-only is a separate selectable game")
	picker.free()
	DirAccess.make_dir_recursive_absolute(folder.path_join("BFME2"))
	var cfg := FileAccess.open(folder.path_join("install-paths.cfg"), FileAccess.WRITE)
	cfg.store_string("ROTWK_INSTALL=\nBFME2_INSTALL=" + folder.path_join("BFME2") + "\n")
	cfg.close()
	OS.set_environment("ROTWK_INSTALL", "")
	OS.set_environment("BFME2_INSTALL", "")
	check(not Paths.game_folders(folder).found, "RotWK selection still needs its install")
	var found := Paths.game_folders(folder, true)
	check(found.found and found.rotwk.is_empty() and found.bfme2 == folder.path_join("BFME2"), "BFME2-only recognizes the remembered base installation")
	OS.set_environment("OPENBFME_GAME_USER_DIR", folder)
	updater.data_dir = folder.path_join("launcher")
	DirAccess.make_dir_recursive_absolute(updater.data_dir)
	check(updater.select_game("bfme2-106") == OK, "picker choice is persisted for direct game starts")
	var selection := ConfigFile.new()
	check(selection.load(folder.path_join("game-selection.cfg")) == OK, "direct game selection file exists")
	check(selection.get_value("game", "selected") == "bfme2-106", "direct game sees standalone selection")
	updater.state.set_value("launcher", "game", "bfme2")
	check(updater.selected_game() == "bfme2-106", "shared selection overrides stale launcher state")
	check(updater.select_game("bfme2") == OK, "switch back persists RotWK selection")
	selection.load(folder.path_join("game-selection.cfg"))
	check(selection.get_value("game", "selected") == "bfme2", "direct game sees restored RotWK selection")
	check(Paths.show_in_file_manager(folder.path_join("BFME2")).is_empty(), "Show folder accepts the standalone BFME2 folder")
	var old_rotwk := folder.path_join("previous RotWK")
	DirAccess.make_dir_recursive_absolute(old_rotwk)
	var previous := FileAccess.open(folder.path_join(Aio.MARKER), FileAccess.WRITE)
	previous.store_string("SOURCE=fixture\nROTWK_INSTALL=" + old_rotwk + "\nBFME2_INSTALL=old BFME2\n")
	previous.close()
	check(aio.write_marker({"bfme2": folder.path_join("BFME2")}).is_empty(), "standalone marker update succeeds")
	var remembered := Paths.read_cfg(folder.path_join(Aio.MARKER))
	check(remembered.ROTWK_INSTALL == old_rotwk, "standalone download retains the previous RotWK location")
	check(remembered.BFME2_INSTALL == folder.path_join("BFME2"), "standalone download replaces the BFME2 location")
	var origin := OS.get_environment("OPENBFME_AIO_ORIGIN")
	if not origin.is_empty():
		updater.data_dir = folder.path_join("launcher")
		DirAccess.make_dir_recursive_absolute(updater.data_dir)
		updater.state.set_value("aio", "enabled", true)
		updater.state.set_value("launcher", "game", "bfme2-106")
		OS.set_environment("OPENBFME_GAME_USER_DIR", folder.path_join("game-user"))
		check(aio.set_test_origin(origin).is_empty(), "synthetic service origin is accepted")
		check(aio.set_test_pins(OS.get_environment("OPENBFME_AIO_PINS")).is_empty(), "synthetic pins are accepted")
		check(aio.choose(Aio.BFME2_ONLY).is_empty(), "select standalone package for download")
		var installed: Dictionary = aio.install(folder.path_join("games"), true)
		check(installed.ok, "BFME2-only installation succeeds: " + str(installed))
	if not failed: print("BFME2 OFFER PASS")
	quit(1 if failed else 0)
